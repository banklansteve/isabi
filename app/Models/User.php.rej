+    /**
+     * Whether this staff member has an approved leave request covering today.
+     */
+    public function isOnLeaveOn(?\Illuminate\Support\Carbon $date = null): bool
+    {
+        $date = ($date ?? now())->toDateString();
+
+        return $this->leaveRequests()
+            ->where('status', LeaveRequest::STATUS_APPROVED)
+            ->where('start_date', '<=', $date)
